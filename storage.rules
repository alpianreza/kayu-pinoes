// ---------------------------------------------------------------------------
// Security Rules Cloud Storage - Kayu Pinoes
// ---------------------------------------------------------------------------
// CATATAN:
//   1. Email admin sudah diisi di bawah: alpianrezha@gmail.com
//      Nilainya harus sama persis dengan NEXT_PUBLIC_ADMIN_EMAIL di .env.local.
//   2. Security Rules tidak bisa membaca environment variable, jadi email
//      ditulis literal (hard-coded) di file ini.
//   3. Perbandingan email case-sensitive: tulis dengan huruf kecil semua.
//   4. Storage hanya tersedia pada plan Blaze. Selama belum dipakai, berkas ini
//      boleh dibiarkan; upload foto tidak dijalankan.
//
// Deploy:
//   npx firebase-tools deploy --only storage
// ---------------------------------------------------------------------------

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email != null
        && request.auth.token.email == "alpianrezha@gmail.com";
    }

    // Gambar produk.
    // - Boleh dibaca siapa saja (halaman publik menampilkan foto produk).
    // - Hanya admin yang boleh menulis.
    // - Batas 5 MB dan hanya berkas gambar.
    // Batas yang sama juga divalidasi di sisi klien
    // (lihat MAX_PRODUCT_IMAGE_BYTES pada src/lib/firebase-product-admin.ts).
    match /products/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }
  }
}
